# =============================================================
#  Who Salted It? — repo root .gitignore
#  레이아웃:  ./docs/          기획 문서
#             ./WhoSaltedIn/   Unity 프로젝트
#  유니티 프로젝트가 하위 폴더에 있으므로 패턴에 선행 슬래시를
#  붙이지 않는다. (붙이면 repo 루트에서만 매칭된다)
# =============================================================

# ---- Unity: 생성물 / 캐시 ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ---- Unity: Addressables 빌드 산출물 ----
**/[Aa]ssets/[Ss]treamingAssets/aa/
**/[Aa]ssets/[Ss]treamingAssets/aa.meta

# ---- Unity: .meta 는 절대 무시하지 않는다 ----
# Assets/ 아래 .meta 가 하나라도 빠지면 다른 사람 에디터에서
# 참조가 통째로 깨진다. 위 규칙들보다 우선하도록 뒤에 둔다.
!**/[Aa]ssets/**/*.meta
!**/[Pp]ackages/**/*.meta

# ---- IDE / 자동 생성 프로젝트 파일 ----
# Unity 가 열 때마다 다시 만든다. 커밋하면 충돌만 난다.
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.opendb
*.VC.db
.vs/
.idea/
.vscode/
ExportedObj/

# ---- 빌드 산출물 ----
*.apk
*.aab
*.app
*.unitypackage
sysinfo.txt
crashlytics-build.properties

# ---- 비밀정보 ----
# UGS(Relay/Lobby/Vivox) 키·토큰은 절대 커밋하지 않는다.
# 공용 프로젝트 ID 는 ProjectSettings 에 들어가며 커밋해도 된다.
.env
.env.local
*.local.json
secrets.*

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
